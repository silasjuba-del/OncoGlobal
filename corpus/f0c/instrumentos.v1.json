    },
    {
      "id": "ALBI", "versao": "Johnson-2015", "ativo": true,
      "fonte": { "tipo": "LITERATURA", "trecho": "where bilirubin is in μmol/L and albumin in g/L.", "referencia": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4322258/", "conferidoEm": "2026-10-10" },
