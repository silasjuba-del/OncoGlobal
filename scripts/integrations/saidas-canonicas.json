            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "encontrados": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "retornados": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "truncado": {
            "type": "boolean"
          }
        },
        "required": [
          "escopo",
          "metodo",
          "completudeFontesExternas",
          "itensConsultaveis",
          "encontrados",
          "retornados",
          "truncado"
        ],
        "additionalProperties": false
      },
      "resultados": {
        "maxItems": 50,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "DocumentRef@1"
            },
            "docId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "pacoteId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "itemId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "versao": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "hashSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "revisaoAcervo": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "titulo": {
              "type": "string"
            },
            "natureza": {
              "type": "string",
              "const": "ITEM_TEXTUAL_CURADO"
            },
            "classificacao": {
              "type": "string",
              "const": "NAO_DECLARADA"
            },
            "originalBinarioDisponivel": {
              "type": "boolean",
              "const": false
            },
            "localizador": {
              "type": "object",
              "properties": {
                "campo": {
                  "type": "string",
                  "enum": [
                    "TEXTO",
                    "TITULO",
                    "TRECHO_FONTE"
                  ]
                },
                "inicio": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "fim": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "unidade": {
                  "type": "string",
                  "const": "UTF16"
                }
              },
              "required": [
                "campo",
                "inicio",
                "fim",
                "unidade"
              ],
              "additionalProperties": false
            },
            "trecho": {
              "type": "string",
              "minLength": 1
            },
            "proveniencia": {
              "type": "object",
              "properties": {
                "fonte": {
                  "type": "string"
                },
                "trecho": {
                  "type": "string"
                },
                "publicadoEm": {
                  "type": "string"
                },
                "recuperadoEm": {
                  "type": "string"
                },
                "licenca": {
                  "type": "string"
                }
              },
              "required": [
                "fonte",
                "trecho",
                "publicadoEm",
                "recuperadoEm",
                "licenca"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schema",
            "docId",
            "pacoteId",
            "itemId",
            "versao",
            "hashSha256",
            "revisaoAcervo",
            "titulo",
            "natureza",
            "classificacao",
            "originalBinarioDisponivel",
            "localizador",
            "trecho",
            "proveniencia"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "codigo",
      "referenciaBiblioteca",
      "revisaoAcervo",
      "cobertura",
      "resultados"
    ],
    "additionalProperties": false
  },
