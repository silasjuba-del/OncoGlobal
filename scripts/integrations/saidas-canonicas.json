{
  "acervo_buscar": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "codigo": {
        "type": "string",
        "enum": [
          "ACERVO_RESULTADOS",
          "ACERVO_SEM_RESULTADOS",
          "ACERVO_VAZIO"
        ]
      },
      "referenciaBiblioteca": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "versao": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "versao",
              "hash"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "revisaoAcervo": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "cobertura": {
        "type": "object",
        "properties": {
          "escopo": {
            "type": "string",
            "const": "ITENS_CONSULTAVEIS_DO_PACOTE_ATIVO"
          },
          "metodo": {
            "type": "string",
            "const": "LITERAL_SENSIVEL_A_CAIXA"
          },
