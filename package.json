{
  "name": "oncoglobal",
  "version": "0.0.1",
  "description": "OncoGlobal WORK — motor longitudinal de contexto oncológico (PLANO v1.1)",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:b2": "node tests/f1/s12/browser-b2.js",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:boundaries:fechar-f1-s3": "node scripts/check-boundaries.mjs --fechar-fase=F1-S3",
    "check:corpus": "node scripts/validate-corpus.mjs",
    "verify": "npm run typecheck && npm run check:boundaries && npm run check:corpus && npm test",
    "ui:dev": "vite",
    "oncoassist:local": "node scripts/iniciar-oncoassist.mjs",
    "ui:build": "vite build",
    "test:f1": "vitest run --config tests/adv/vitest.f1.config.ts",
    "verify:f1": "npm run check:boundaries:fechar-f1-s3 && npm run test:f1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silasjuba-del/OncoGlobal.git"
  },
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/silasjuba-del/OncoGlobal/issues"
  },
  "homepage": "https://github.com/silasjuba-del/OncoGlobal#readme",
  "dependencies": {
    "@deepgram/sdk": "5.15.0",
    "@napi-rs/canvas": "1.0.10",
    "@tesseract.js-data/por": "^1.0.0",
    "@typesafe-ai/sdk": "0.6.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "ws": "8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
