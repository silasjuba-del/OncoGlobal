{
  "name": "pdfforge",
  "version": "0.1.0",
  "private": true,
  "description": "Clone funcional de suíte de ferramentas PDF desktop (Electron + React + pdf-lib + pdf.js)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --names web,app \"vite\" \"wait-on tcp:5199 && cross-env PDFFORGE_DEV_URL=http://localhost:5199 electron .\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "electron scripts/smoke-electron.cjs",
    "dev:electron": "cross-env PDFFORGE_DEV_URL=http://localhost:5199 electron ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@cantoo/pdf-lib": "2.3.2",
    "diff": "7.0.0",
    "docx": "9.9.0",
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "openai": "7.31.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@types/diff": "6.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "wait-on": "8.0.1"
  }
}
